# PettyAF backend configuration. Copy to .env and fill in. .env is gitignored.

PORT=4000

# Alebex STAGING platform (REST, JWT auth)
STAGING_API_URL=https://api-staging.alebex.ai/api/v1
STAGING_EMAIL=
STAGING_PASSWORD=
STAGING_ORG_ID=
STAGING_KNOWLEDGE_BASE_ID=

# Persona key -> staging Agent id. Roster: child, medieval, angry.
PERSONA_AGENT_MAP={"child":"","medieval":"","angry":""}

# Alebex voice engine (X-API-Key, used for live call-status polling only)
VOICE_ENGINE_URL=https://voice.alebex.ai
VOICE_ENGINE_API_KEY=

# Optional alternative lead-ingestion path (webhook key, not JWT)
WEBHOOK_LEADS_INGEST_URL=
WEBHOOK_LEADS_KEY=

# FE origin for CORS
CORS_ORIGIN=http://localhost:5173

# SAFETY RAIL: no real phone call is placed unless this is exactly "true".
DIALING_ENABLED=false

# Engine / dialing tuning
MAX_CONCURRENT_CALLS=1
REDIAL_GAP_MS=8000
ENGINE_POLL_INTERVAL_MS=2000
ANALYZING_TIMEOUT_MS=20000
RELENTLESS_SOFT_CAP=50
